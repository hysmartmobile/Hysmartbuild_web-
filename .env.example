# Vercel Project Settings > Environment Variables (Production + Preview as appropriate).
# Use the public Supabase anon/publishable key only; never put a service-role key here.
VITE_API_URL=https://YOUR-RENDER-SERVICE.onrender.com
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
