# Copy to .env and fill in your own credentials.
NODE_ENV=development
PORT=3001
TRUST_PROXY=false
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Paystack: Nigeria / NGN subscription checkout
PAYSTACK_SECRET_KEY=YOUR_PAYSTACK_SECRET_KEY

# Flutterwave: only enabled country/currency routes supported by your account
FLW_SECRET_KEY=YOUR_FLUTTERWAVE_SECRET_KEY
FLW_SECRET_HASH=YOUR_FLUTTERWAVE_WEBHOOK_SECRET_HASH

# Stripe: USD subscriptions outside Nigeria
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SIGNING_SECRET

BILLING_CALLBACK_URL=http://localhost:5173/billing/callback
WEB_APP_URL=http://localhost:5173
CUSTOMER_CARE_LOCAL_MODEL_URL=http://127.0.0.1:11434
CUSTOMER_CARE_LOCAL_MODEL_NAME=qwen2.5:7b
