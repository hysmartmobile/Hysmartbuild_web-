import { randomUUID } from 'node:crypto';
const clean=v=>typeof v==='string'?v.trim():v;
const tables={rfis:'collaboration_rfis',submittals:'collaboration_submittals',drawings:'collaboration_drawings',transmittals:'collaboration_transmittals',instructions:'collaboration_site_instructions'};
const statuses={rfi:['CLOSED','CANCELLED'],instruction:['CLOSED','CANCELLED']};
export class CollaborationService{
 constructor({supabase}){this.supabase=supabase;}
 async assertProject({companyId,projectId,userId,role}){const {data,error}=await this.supabase.from('projects').select('id,company_id,name').eq('company_id',companyId).eq('id',projectId).maybeSingle();if(error)throw error;if(!data)throw Object.assign(new Error('Project not found'),{code:'PROJECT_NOT_FOUND',status:404});if(role==='CLIENT'){const {data:a,error:ae}=await this.supabase.from('project_client_access').select('id').eq('company_id',companyId).eq('project_id',projectId).eq('user_id',userId).eq('status','ACTIVE').maybeSingle();if(ae)throw ae;if(!a)throw Object.assign(new Error('Project access denied'),{code:'PROJECT_ACCESS_DENIED',status:403});}return data;}
 async audit(p){const {error}=await this.supabase.from('collaboration_audit_events').insert({company_id:p.companyId,project_id:p.projectId,entity_type:p.entityType,entity_id:p.entityId,action:p.action,actor_user_id:p.actorUserId,metadata:p.metadata||{}});if(error)throw error;}
 async notify({companyId,projectId,actorUserId,title,body,type,recipients=[]}){const ids=[...new Set(recipients.filter(Boolean).filter(x=>x!==actorUserId))];if(!ids.length)return;const {error}=await this.supabase.from('notifications').insert(ids.map(recipient_user_id=>({id:randomUUID(),company_id:companyId,project_id:projectId,recipient_user_id,actor_user_id:actorUserId,type,title,body})));if(error)throw error;}
 async recipients({companyId,projectId}){const {data,error}=await this.supabase.from('project_members').select('user_id').eq('company_id',companyId).eq('project_id',projectId).eq('status','ACTIVE');if(error)throw error;return (data||[]).map(x=>x.user_id).filter(Boolean);}
 async nextNo({companyId,projectId,prefix,table}){const {count,error}=await this.supabase.from(table).select('id',{count:'exact',head:true}).eq('company_id',companyId).eq('project_id',projectId);if(error)throw error;return `${prefix}-${String((count||0)+1).padStart(4,'0')}`;}
 async list(kind,p){await this.assertProject(p);const {data,error}=await this.supabase.from(tables[kind]).select('*').eq('company_id',p.companyId).eq('project_id',p.projectId).order('updated_at',{ascending:false});if(error)throw error;return data||[];}
 async createRfi(p){await this.assertProject(p);const no=p.input.rfiNo||await this.nextNo({...p,prefix:'RFI',table:tables.rfis});const row={id:randomUUID(),company_id:p.companyId,project_id:p.projectId,rfi_no:no,subject:clean(p.input.subject),question:clean(p.input.question),category:clean(p.input.category)||null,priority:p.input.priority,status:'SUBMITTED',raised_by:p.userId,assigned_to:p.input.assignedTo||null,due_date:p.input.dueDate||null,evidence:p.input.evidence||[]};const {data,error}=await this.supabase.from(tables.rfis).insert(row).select().single();if(error)throw error;await this.audit({companyId:p.companyId,projectId:p.projectId,entityType:'RFI',entityId:data.id,action:'SUBMITTED',actorUserId:p.userId,metadata:{rfiNo:no}});await this.notify({companyId:p.companyId,projectId:p.projectId,actorUserId:p.userId,title:`RFI ${no} submitted`,body:data.subject,type:'RFI_SUBMITTED',recipients:p.input.assignedTo?[p.input.assignedTo]:await this.recipients(p)});return data;}
 async updateRfi(p){await this.assertProject(p);const patch={...p.input};if(p.input.response!==undefined){patch.responded_by=p.userId;patch.responded_at=new Date().toISOString();patch.status=p.input.status||'RESPONDED';}if(p.input.status==='CLOSED'){patch.closed_by=p.userId;patch.closed_at=new Date().toISOString();}const {data,error}=await this.supabase.from(tables.rfis).update(patch).eq('company_id',p.companyId).eq('project_id',p.projectId).eq('id',p.id).select().single();if(error)throw error;await this.audit({companyId:p.companyId,projectId:p.projectId,entityType:'RFI',entityId:p.id,action:`STATUS_${data.status}`,actorUserId:p.userId,metadata:{}});return data;}
 async createSubmittal(p){await this.assertProject(p);const no=p.input.submittalNo||await this.nextNo({...p,prefix:'SUB',table:tables.submittals});const {data,error}=await this.supabase.from(tables.submittals).insert({id:randomUUID(),company_id:p.companyId,project_id:p.projectId,submittal_no:no,title:clean(p.input.title),discipline:clean(p.input.discipline)||null,specification_ref:clean(p.input.specificationRef)||null,status:'SUBMITTED',submitted_by:p.userId,reviewer_user_id:p.input.reviewerUserId||null,due_date:p.input.dueDate||null,document_ids:p.input.documentIds||[]}).select().single();if(error)throw error;await this.audit({companyId:p.companyId,projectId:p.projectId,entityType:'SUBMITTAL',entityId:data.id,action:'SUBMITTED',actorUserId:p.userId,metadata:{submittalNo:no}});return data;}
 async updateSubmittal(p){await this.assertProject(p);const patch={...p.input};if(['APPROVED','APPROVED_WITH_COMMENTS','REJECTED'].includes(p.input.status)){patch.reviewed_by=p.userId;patch.reviewed_at=new Date().toISOString();}const {data,error}=await this.supabase.from(tables.submittals).update(patch).eq('company_id',p.companyId).eq('project_id',p.projectId).eq('id',p.id).select().single();if(error)throw error;await this.audit({companyId:p.companyId,projectId:p.projectId,entityType:'SUBMITTAL',entityId:p.id,action:`STATUS_${data.status}`,actorUserId:p.userId,metadata:{}});return data;}
 async createDrawing(p){await this.assertProject(p);const {data,error}=await this.supabase.from(tables.drawings).insert({id:randomUUID(),company_id:p.companyId,project_id:p.projectId,drawing_no:clean(p.input.drawingNo),title:clean(p.input.title),discipline:clean(p.input.discipline)||null,status:'CURRENT',current_revision:clean(p.input.revision),created_by:p.userId}).select().single();if(error)throw error;const {data:rev,error:re}=await this.supabase.from('collaboration_drawing_revisions').insert({id:randomUUID(),company_id:p.companyId,drawing_id:data.id,revision:clean(p.input.revision),revision_date:p.input.revisionDate||new Date().toISOString().slice(0,10),description:clean(p.input.description)||null,status:'CURRENT',document_id:p.input.documentId||null,issued_by:p.userId}).select().single();if(re)throw re;await this.audit({companyId:p.companyId,projectId:p.projectId,entityType:'DRAWING',entityId:data.id,action:'ISSUED',actorUserId:p.userId,metadata:{revision:rev.revision}});return {...data,revision:rev};}
 async addDrawingRevision(p){await this.assertProject(p);const {data:old,error:oe}=await this.supabase.from(tables.drawings).select('id').eq('company_id',p.companyId).eq('project_id',p.projectId).eq('id',p.drawingId).maybeSingle();if(oe)throw oe;if(!old)throw Object.assign(new Error('Drawing not found'),{code:'DRAWING_NOT_FOUND',status:404});const {error:se}=await this.supabase.from('collaboration_drawing_revisions').update({status:'SUPERSEDED'}).eq('company_id',p.companyId).eq('drawing_id',p.drawingId).eq('status','CURRENT');if(se)throw se;const {data:rev,error}=await this.supabase.from('collaboration_drawing_revisions').insert({id:randomUUID(),company_id:p.companyId,drawing_id:p.drawingId,revision:clean(p.input.revision),revision_date:p.input.revisionDate||new Date().toISOString().slice(0,10),description:clean(p.input.description)||null,status:'CURRENT',document_id:p.input.documentId||null,issued_by:p.userId}).select().single();if(error)throw error;const {data:draw,error:de}=await this.supabase.from(tables.drawings).update({current_revision:rev.revision,status:'CURRENT'}).eq('company_id',p.companyId).eq('project_id',p.projectId).eq('id',p.drawingId).select().single();if(de)throw de;await this.audit({companyId:p.companyId,projectId:p.projectId,entityType:'DRAWING',entityId:p.drawingId,action:'REVISION_ISSUED',actorUserId:p.userId,metadata:{revision:rev.revision}});return{drawing:draw,revision:rev};}
 async createTransmittal(p){await this.assertProject(p);const no=p.input.transmittalNo||await this.nextNo({...p,prefix:'TR',table:tables.transmittals});const {data,error}=await this.supabase.from(tables.transmittals).insert({id:randomUUID(),company_id:p.companyId,project_id:p.projectId,transmittal_no:no,subject:clean(p.input.subject),recipient_name:clean(p.input.recipientName)||null,recipient_user_id:p.input.recipientUserId||null,purpose:clean(p.input.purpose)||null,status:'SENT',sent_by:p.userId,sent_at:new Date().toISOString(),item_ids:p.input.itemIds||[]}).select().single();if(error)throw error;await this.audit({companyId:p.companyId,projectId:p.projectId,entityType:'TRANSMITTAL',entityId:data.id,action:'SENT',actorUserId:p.userId,metadata:{transmittalNo:no}});if(p.input.recipientUserId)await this.notify({companyId:p.companyId,projectId:p.projectId,actorUserId:p.userId,title:`Transmittal ${no}`,body:data.subject,type:'TRANSMITTAL',recipients:[p.input.recipientUserId]});return data;}
 async createInstruction(p){await this.assertProject(p);const no=p.input.instructionNo||await this.nextNo({...p,prefix:'SI',table:tables.instructions});const {data,error}=await this.supabase.from(tables.instructions).insert({id:randomUUID(),company_id:p.companyId,project_id:p.projectId,instruction_no:no,subject:clean(p.input.subject),instruction:clean(p.input.instruction),priority:p.input.priority,status:'ISSUED',issued_by:p.userId,assigned_to:p.input.assignedTo||null,due_date:p.input.dueDate||null,evidence:p.input.evidence||[]}).select().single();if(error)throw error;await this.audit({companyId:p.companyId,projectId:p.projectId,entityType:'SITE_INSTRUCTION',entityId:data.id,action:'ISSUED',actorUserId:p.userId,metadata:{instructionNo:no}});if(p.input.assignedTo)await this.notify({companyId:p.companyId,projectId:p.projectId,actorUserId:p.userId,title:`Site instruction ${no}`,body:data.subject,type:'SITE_INSTRUCTION',recipients:[p.input.assignedTo]});return data;}
 async updateInstruction(p){await this.assertProject(p);const patch={...p.input};if(p.input.status==='ACKNOWLEDGED'){patch.acknowledged_by=p.userId;patch.acknowledged_at=new Date().toISOString();}if(p.input.status==='CLOSED'){patch.closed_by=p.userId;patch.closed_at=new Date().toISOString();}const {data,error}=await this.supabase.from(tables.instructions).update(patch).eq('company_id',p.companyId).eq('project_id',p.projectId).eq('id',p.id).select().single();if(error)throw error;await this.audit({companyId:p.companyId,projectId:p.projectId,entityType:'SITE_INSTRUCTION',entityId:p.id,action:`STATUS_${data.status}`,actorUserId:p.userId,metadata:{}});return data;}
 async updateTransmittal(p){await this.assertProject(p);const patch={...p.input};if(p.input.status==='ACKNOWLEDGED'){patch.acknowledged_by=p.userId;patch.acknowledged_at=new Date().toISOString();}const {data,error}=await this.supabase.from(tables.transmittals).update(patch).eq('company_id',p.companyId).eq('project_id',p.projectId).eq('id',p.id).select().single();if(error)throw error;await this.audit({companyId:p.companyId,projectId:p.projectId,entityType:'TRANSMITTAL',entityId:p.id,action:`STATUS_${data.status}`,actorUserId:p.userId,metadata:{}});return data;}
 async drawingRevisions(p){await this.assertProject(p);const {data,error}=await this.supabase.from('collaboration_drawing_revisions').select('*').eq('company_id',p.companyId).eq('drawing_id',p.drawingId).order('revision_date',{ascending:false});if(error)throw error;return data||[];}
 async commentTarget(p){const map={RFI:[tables.rfis],SUBMITTAL:[tables.submittals],DRAWING:[tables.drawings],TRANSMITTAL:[tables.transmittals],SITE_INSTRUCTION:[tables.instructions],TASK:['tasks'],ISSUE:['issues'],PURCHASE_ORDER:['purchase_orders'],NCR:['quality_ncrs','project_ncrs'],SAFETY_INCIDENT:['safety_incidents','project_safety_incidents'],DAILY_REPORT:['daily_site_reports'],CHANGE_ORDER:['project_change_orders'],WORKFRONT:['project_workfronts'],PRODUCTION:['project_production_entries'],BOQ_ITEM:['project_estimate_items']};const candidates=map[p.entityType];if(!candidates)throw Object.assign(new Error('Unsupported comment record type'),{code:'COMMENT_ENTITY_UNSUPPORTED',status:400});for(const table of candidates){let q=this.supabase.from(table).select('id,project_id').eq('company_id',p.companyId).eq('id',p.entityId);if(table!=='purchase_orders')q=q.eq('project_id',p.projectId);const {data,error}=await q.maybeSingle();if(error&&error.code!=='PGRST205')throw error;if(data&&((table==='purchase_orders')?data.project_id===p.projectId:true))return data;}throw Object.assign(new Error('Comment record not found in project'),{code:'COLLABORATION_NOT_FOUND',status:404});}
 async validateMentions({companyId,projectId,mentions=[]}){const ids=[...new Set((mentions||[]).filter(Boolean))];if(!ids.length)return[];const {data,error}=await this.supabase.from('project_members').select('user_id').eq('company_id',companyId).eq('project_id',projectId).eq('status','ACTIVE').in('user_id',ids);if(error)throw error;const allowed=new Set((data||[]).map(x=>x.user_id));const invalid=ids.filter(x=>!allowed.has(x));if(invalid.length)throw Object.assign(new Error('One or more mentioned users are not active project members'),{code:'COMMENT_INVALID_MENTION',status:400});return ids;}
 async commentRecipients(p,parent,mentions){const ids=new Set();if(parent?.author_user_id)ids.add(parent.author_user_id);for(const id of mentions)ids.add(id);ids.delete(p.userId);return [...ids];}
 async addComment(p){await this.assertProject(p);await this.commentTarget({companyId:p.companyId,projectId:p.projectId,entityType:p.input.entityType,entityId:p.input.entityId});let parent=null;if(p.input.parentId){const {data,error}=await this.supabase.from('collaboration_comments').select('id,author_user_id,entity_type,entity_id').eq('company_id',p.companyId).eq('project_id',p.projectId).eq('id',p.input.parentId).maybeSingle();if(error)throw error;if(!data||data.entity_type!==p.input.entityType||data.entity_id!==p.input.entityId)throw Object.assign(new Error('Reply parent does not belong to this record'),{code:'COMMENT_PARENT_INVALID',status:400});parent=data;}const mentions=await this.validateMentions({companyId:p.companyId,projectId:p.projectId,mentions:p.input.mentions||[]});const attachments=[...new Set(p.input.attachmentIds||[])];if(attachments.length){const {data:docs,error:de}=await this.supabase.from('documents').select('id,project_id').eq('company_id',p.companyId).in('id',attachments);if(de)throw de;if((docs||[]).length!==attachments.length||(docs||[]).some(d=>d.project_id!==p.projectId))throw Object.assign(new Error('Comment attachments must belong to the project'),{code:'COMMENT_ATTACHMENT_INVALID',status:400});}const {data,error}=await this.supabase.from('collaboration_comments').insert({id:randomUUID(),company_id:p.companyId,project_id:p.projectId,entity_type:p.input.entityType,entity_id:p.input.entityId,parent_id:p.input.parentId||null,author_user_id:p.userId,body:clean(p.input.body),mentions,attachment_ids:attachments}).select().single();if(error)throw error;await this.audit({companyId:p.companyId,projectId:p.projectId,entityType:p.input.entityType,entityId:p.input.entityId,action:parent?'COMMENT_REPLIED':'COMMENT_ADDED',actorUserId:p.userId,metadata:{commentId:data.id,parentId:parent?.id||null,mentions,attachmentIds:attachments}});const recipients=await this.commentRecipients(p,parent,mentions);await this.notify({companyId:p.companyId,projectId:p.projectId,actorUserId:p.userId,title:parent?'New reply':'New comment',body:clean(p.input.body).slice(0,240),type:parent?'COMMENT_REPLY':'COMMENT_MENTION',recipients});return data;}
 async comments(p){await this.assertProject(p);if(!p.entityType||!p.entityId)throw Object.assign(new Error('entityType and entityId are required'),{code:'VALIDATION_ERROR',status:400});await this.commentTarget({companyId:p.companyId,projectId:p.projectId,entityType:p.entityType,entityId:p.entityId});const {data,error}=await this.supabase.from('collaboration_comments').select('*').eq('company_id',p.companyId).eq('project_id',p.projectId).eq('entity_type',p.entityType).eq('entity_id',p.entityId).is('deleted_at',null).order('created_at',{ascending:true});if(error)throw error;const rows=data||[];const ids=[...new Set(rows.map(x=>x.author_user_id).filter(Boolean))];let profiles=[];if(ids.length){const {data:pfs,error:pe}=await this.supabase.from('profiles').select('id,full_name,avatar_url').in('id',ids);if(pe)throw pe;profiles=pfs||[];}const by=new Map(profiles.map(x=>[x.id,x]));return rows.map(x=>({...x,author:by.get(x.author_user_id)||{id:x.author_user_id,full_name:'Project member',avatar_url:null}}));}
 async updateComment(p){await this.assertProject(p);const {data:row,error:re}=await this.supabase.from('collaboration_comments').select('id,author_user_id,project_id,entity_type,entity_id').eq('company_id',p.companyId).eq('project_id',p.projectId).eq('id',p.id).is('deleted_at',null).maybeSingle();if(re)throw re;if(!row)throw Object.assign(new Error('Comment not found'),{code:'COMMENT_NOT_FOUND',status:404});if(row.author_user_id!==p.userId && !['SUPER_ADMIN','COMPANY_OWNER','COMPANY_ADMIN','DIRECTOR','PROJECT_MANAGER'].includes(p.role))throw Object.assign(new Error('You can only edit your own comments'),{code:'COMMENT_EDIT_FORBIDDEN',status:403});const {data,error}=await this.supabase.from('collaboration_comments').update({body:clean(p.input.body),edited_by:p.userId,edited_at:new Date().toISOString()}).eq('company_id',p.companyId).eq('project_id',p.projectId).eq('id',p.id).select().single();if(error)throw error;await this.audit({companyId:p.companyId,projectId:p.projectId,entityType:row.entity_type,entityId:row.entity_id,action:'COMMENT_EDITED',actorUserId:p.userId,metadata:{commentId:p.id}});return data;}
 async deleteComment(p){await this.assertProject(p);const {data:row,error:re}=await this.supabase.from('collaboration_comments').select('id,author_user_id,entity_type,entity_id').eq('company_id',p.companyId).eq('project_id',p.projectId).eq('id',p.id).is('deleted_at',null).maybeSingle();if(re)throw re;if(!row)throw Object.assign(new Error('Comment not found'),{code:'COMMENT_NOT_FOUND',status:404});if(row.author_user_id!==p.userId && !['SUPER_ADMIN','COMPANY_OWNER','COMPANY_ADMIN','DIRECTOR','PROJECT_MANAGER'].includes(p.role))throw Object.assign(new Error('Comment deletion forbidden'),{code:'COMMENT_DELETE_FORBIDDEN',status:403});const {data,error}=await this.supabase.from('collaboration_comments').update({deleted_at:new Date().toISOString(),deleted_by:p.userId}).eq('company_id',p.companyId).eq('project_id',p.projectId).eq('id',p.id).select().single();if(error)throw error;await this.audit({companyId:p.companyId,projectId:p.projectId,entityType:row.entity_type,entityId:row.entity_id,action:'COMMENT_DELETED',actorUserId:p.userId,metadata:{commentId:p.id}});return data;}
 async dashboard(p){await this.assertProject(p);const qs=Object.entries(tables).map(([k,t])=>this.supabase.from(t).select(['rfis','submittals','instructions'].includes(k)?'id,status,due_date':'id,status').eq('company_id',p.companyId).eq('project_id',p.projectId));const out=await Promise.all(qs);for(const x of out)if(x.error)throw x.error;const [rfi,sub,draw,trans,ins]=out,today=new Date().toISOString().slice(0,10),over=(rows,closed)=>rows.filter(x=>x.due_date&&x.due_date<today&&!closed.includes(x.status)).length;return{summary:{rfis:rfi.data.length,openRfis:rfi.data.filter(x=>!statuses.rfi.includes(x.status)).length,overdueRfis:over(rfi.data,statuses.rfi),submittals:sub.data.length,pendingSubmittals:sub.data.filter(x=>['SUBMITTED','UNDER_REVIEW','RESUBMIT'].includes(x.status)).length,drawings:draw.data.length,currentDrawings:draw.data.filter(x=>x.status==='CURRENT').length,transmittals:trans.data.length,unacknowledgedTransmittals:trans.data.filter(x=>x.status==='SENT').length,siteInstructions:ins.data.length,openInstructions:ins.data.filter(x=>!statuses.instruction.includes(x.status)).length,overdueInstructions:over(ins.data,statuses.instruction)}};}
}
